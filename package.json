    "predb:seed:week11": "npm run db:generate",
    "test:week12": "node scripts/prepare-week12-test.mjs && tsx scripts/verify-week12-reports.ts && tsx scripts/verify-week12-anomalies.ts && tsx scripts/verify-week12-exports.ts",
