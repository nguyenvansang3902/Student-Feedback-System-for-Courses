{
  "name": "website-khao-sat-phan-hoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run db:validate && npm run db:generate && npm run design:check && eslint . && tsc --noEmit && vitest run",
    "pretest": "npm run db:generate",
    "test:integration": "node scripts/verify-database.mjs",
    "progress": "node scripts/progress.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "prisma validate && prisma validate --schema prisma/design.prisma",
    "db:generate": "prisma generate && prisma generate --schema prisma/design.prisma",
    "db:prepare": "node scripts/prepare-database.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "design:diagrams": "node scripts/export-erd.mjs",
    "design:check": "node scripts/export-erd.mjs --check",
    "auth:key": "node scripts/generate-auth-key.mjs",
    "db:seed": "tsx scripts/seed-auth.ts && tsx scripts/seed-demo.ts",
    "demo": "node scripts/demo.mjs",
    "predemo": "npm run db:generate",
    "test:auth": "tsx scripts/verify-auth.ts",
    "predb:seed": "npm run db:generate",
    "pretest:auth": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "admin:create": "tsx scripts/admin-console.ts create",
    "admin:reset-2fa": "tsx scripts/admin-console.ts reset-mfa",
    "preadmin:create": "npm run db:generate",
    "preadmin:reset-2fa": "npm run db:generate",
    "test:week4": "node scripts/prepare-week4-test.mjs && tsx scripts/verify-admin-console.ts && tsx scripts/verify-week4.ts",
    "pretest:week4": "npm run db:generate",
    "test:week5": "node scripts/prepare-week4-test.mjs && tsx scripts/verify-week5.ts",
    "pretest:week5": "npm run db:generate",
    "test:demo": "node scripts/test-demo.mjs",
    "pretest:demo": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.5",
    "exceljs": "4.4.0",
    "jose": "6.2.13",
    "next": "16.3.8",
    "nodemailer": "10.1.7",
    "otplib": "13.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@prisma/generator-helper": "7.10.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
