# Tạo .local/production/.env từ tệp mẫu và dùng --env-file rõ ràng.
# APP_URL là origin HTTPS của reverse proxy (không có path, query hoặc fragment).
SFS_PROD_APP_URL=https://khao-sat.example.invalid
SFS_PROD_LOCAL_PORT=3016

# Tên DB và user chỉ dùng A-Z, a-z, 0-9, gạch dưới.
# Sinh riêng hai mật khẩu DB dạng hex ngẫu nhiên để ghép vào DATABASE_URL.
SFS_PROD_DB_NAME=sfs_production
SFS_PROD_DB_USER=sfs_app
SFS_PROD_DB_PASSWORD=
SFS_PROD_DB_ROOT_PASSWORD=

# Sinh riêng hai khóa 32 byte dạng hex. Giữ khóa MFA và version để khôi phục 2FA.
SFS_PROD_JWT_SECRET=
SFS_PROD_MFA_KEY=
SFS_PROD_MFA_KEY_VERSION=v1
# Chỉ bật nếu reverse proxy đáng tin ghi đè mọi header nguồn IP.
SFS_PROD_TRUST_PROXY=false

SFS_PROD_SMTP_HOST=
SFS_PROD_SMTP_PORT=587
SFS_PROD_SMTP_FROM=
SFS_PROD_SMTP_USER=
SFS_PROD_SMTP_PASSWORD=
