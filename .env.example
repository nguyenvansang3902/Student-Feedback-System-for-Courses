# Chỉ dùng cho môi trường phát triển cục bộ; thay các giá trị mẫu nếu cần.
# Không commit tệp .env đã sao chép từ tệp này.
MYSQL_ROOT_PASSWORD=local_root_change_me
MYSQL_DATABASE=survey_feedback
MYSQL_USER=survey_dev
MYSQL_PASSWORD=local_dev_change_me

# Phải đồng bộ với MYSQL_DATABASE, MYSQL_USER và MYSQL_PASSWORD ở trên.
DATABASE_URL="mysql://survey_dev:local_dev_change_me@127.0.0.1:3306/survey_feedback"

# Chạy npm run db:prepare để tạo và ghi SHADOW_DATABASE_URL riêng vào .env.
# Không dùng database chính hoặc database có dữ liệu cần giữ làm shadow.

# Mailpit chỉ bắt email cục bộ, chưa có chức năng gửi email ở Tuần 1.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="no-reply@localhost"
