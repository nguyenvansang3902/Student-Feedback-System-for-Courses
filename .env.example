# Chỉ dùng cho môi trường phát triển cục bộ; thay các giá trị mẫu nếu cần.
# Không commit tệp .env đã sao chép từ tệp này.
MYSQL_ROOT_PASSWORD=local_root_change_me
MYSQL_DATABASE=survey_feedback
MYSQL_USER=survey_dev
MYSQL_PASSWORD=local_dev_change_me

# Phải đồng bộ với MYSQL_DATABASE, MYSQL_USER và MYSQL_PASSWORD ở trên.
DATABASE_URL="mysql://survey_dev:local_dev_change_me@127.0.0.1:3306/survey_feedback"

# Chạy npm run db:prepare để tạo và ghi SHADOW_DATABASE_URL riêng vào .env.
# Không dùng database chính hoặc database có dữ liệu cần giữ làm shadow.

# Mailpit chỉ bắt email cục bộ, chưa có chức năng gửi email ở Tuần 1.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="no-reply@localhost.invalid"

# Tuần 3: chạy npm run auth:key để sinh JWT_SECRET riêng trong .env.
APP_URL="http://localhost:3000"
JWT_SECRET=""
MFA_ENCRYPTION_KEY=""
MFA_KEY_VERSION="v1"
# test:week4 tự tạo W4_TEST_DATABASE_URL trong .env riêng, khác main và shadow.
JWT_ISSUER="student-feedback-system"
JWT_AUDIENCE="student-feedback-web"
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
BCRYPT_COST=12
# Chỉ bật khi reverse proxy đáng tin đã ghi đè header client IP.
AUTH_TRUST_PROXY=false
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=1800
ACTIVATION_TTL_SECONDS=86400
RECOVERY_WINDOW_SECONDS=900
RECOVERY_LOCK_SECONDS=900
RECOVERY_REQUEST_IP_LIMIT=10
RECOVERY_REQUEST_ACCOUNT_LIMIT=3
RECOVERY_COMPLETE_IP_LIMIT=20
RECOVERY_COMPLETE_TOKEN_LIMIT=5

# Seed/demo cục bộ: small | medium | large. Demo dùng database riêng, cổng riêng.
DEMO_SIZE=medium
DEMO_PORT=3001
