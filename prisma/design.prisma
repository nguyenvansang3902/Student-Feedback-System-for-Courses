// THIẾT KẾ TOÀN HỆ THỐNG: xem docs/decisions/ADR-002-schema-theo-tuan.md.
// Blueprint 46 model; runtime Tuần 8 ở schema.prisma, chưa tổng hợp/công bố kết quả.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/design-prisma"
}

datasource db {
  provider = "mysql"
}

generator metadata {
  provider = "node ./scripts/generate-dmmf.mjs"
  output   = "../src/generated/design-metadata"
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum Role {
  SINH_VIEN
  GIANG_VIEN
  TRUONG_BO_MON
  TRUONG_KHOA
  CAN_BO_DBCL
  LANH_DAO
  ADMIN
  PHONG_DAO_TAO
  PHONG_KHAO_THI
  THANH_TRA
}

enum ScopeType {
  GLOBAL
  FACULTY
  DEPARTMENT
}

model User {
  dataConfirmations           CampaignDataConfirmation[]
  inspectionAssigned          InspectionCase[]           @relation("InspectionAssignee")
  inspectionCreated           InspectionCase[]           @relation("InspectionCreator")
  inspectionNotes             InspectionCaseNote[]
  inspectionEvents            InspectionCaseEvent[]
  reviewedAnomalies           SurveyAnomalyFlag[]
  examRecommendationsSent     ExamReviewRecommendation[] @relation("ExamSender")
  examRecommendationsReceived ExamReviewRecommendation[] @relation("ExamRecipient")
  importBatches               ImportBatch[]
  id                          String                     @id @default(uuid()) @db.Char(36)
  loginCode                   String                     @unique @db.VarChar(32)
  email                       String                     @unique @db.VarChar(254)
  displayName                 String                     @db.VarChar(160)
  passwordHash                String?                    @db.VarChar(255)
  status                      UserStatus                 @default(PENDING_ACTIVATION)
  mustChangePassword          Boolean                    @default(true)
  createdAt                   DateTime                   @default(now()) @db.DateTime(3)
  updatedAt                   DateTime                   @updatedAt @db.DateTime(3)
  roles                       RoleAssignment[]
  teaching                    TeachingAssignment[]
  enrollments                 Enrollment[]
  sessions                    UserSession[]
  authTokens                  AuthToken[]
  totp                        TotpCredential?
  templates                   SurveyTemplate[]
  createdCampaigns            SurveyCampaign[]           @relation("CampaignCreator")
  approvedCampaigns           SurveyCampaign[]           @relation("CampaignApprover")
  campaignHistory             CampaignHistory[]
  tasks                       SurveyTask[]
  teachingImprovements        ImprovementPlan[]          @relation("ImprovementTeacher")
  reviewedImprovements        ImprovementPlan[]          @relation("ImprovementReviewer")
  improvementHistory          ImprovementHistory[]
  feedbackSent                Feedback[]                 @relation("FeedbackAuthor")
  feedbackAssigned            Feedback[]                 @relation("FeedbackAssignee")
  feedbackRecipients          FeedbackRecipient[]
  feedbackMessages            FeedbackMessage[]
  feedbackHistory             FeedbackHistory[]
  reminders                   SurveyReminder[]
  notifications               Notification[]
  settings                    SystemSetting[]
  audit                       AuditLog[]

  @@index([status])
}

model Faculty {
  id          String           @id @default(uuid()) @db.Char(36)
  code        String           @unique @db.VarChar(32)
  name        String           @db.VarChar(160)
  isActive    Boolean          @default(true)
  departments Department[]
  roles       RoleAssignment[]
  campaigns   SurveyCampaign[]
}

model Department {
  id        String           @id @default(uuid()) @db.Char(36)
  code      String           @unique @db.VarChar(32)
  name      String           @db.VarChar(160)
  isActive  Boolean          @default(true)
  facultyId String           @db.Char(36)
  faculty   Faculty          @relation(fields: [facultyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  courses   Course[]
  roles     RoleAssignment[]
  campaigns SurveyCampaign[]

  @@index([facultyId])
}

model Semester {
  id        String           @id @default(uuid()) @db.Char(36)
  code      String           @unique @db.VarChar(32)
  name      String           @db.VarChar(160)
  startsOn  DateTime         @db.Date
  endsOn    DateTime         @db.Date
  lockedAt  DateTime?        @db.DateTime(3)
  sections  CourseSection[]
  campaigns SurveyCampaign[]
}

model Course {
  examRecommendations ExamReviewRecommendation[]
  id                  String                     @id @default(uuid()) @db.Char(36)
  code                String                     @unique @db.VarChar(32)
  name                String                     @db.VarChar(200)
  credits             Decimal                    @db.Decimal(4, 1)
  isActive            Boolean                    @default(true)
  departmentId        String                     @db.Char(36)
  department          Department                 @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sections            CourseSection[]

  @@index([departmentId])
}

model CourseSection {
  anomalyFlags    SurveyAnomalyFlag[]
  inspectionCases InspectionCase[]
  id              String               @id @default(uuid()) @db.Char(36)
  code            String               @db.VarChar(32)
  courseId        String               @db.Char(36)
  semesterId      String               @db.Char(36)
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  semester        Semester             @relation(fields: [semesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teaching        TeachingAssignment[]
  enrollments     Enrollment[]
  campaigns       CampaignSection[]
  feedback        Feedback[]

  @@unique([semesterId, code])
  @@index([courseId])
}

model TeachingAssignment {
  sectionId String        @db.Char(36)
  teacherId String        @db.Char(36)
  isLead    Boolean       @default(false)
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teacher   User          @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sectionId, teacherId])
  @@index([teacherId])
}

model Enrollment {
  id           String        @id @default(uuid()) @db.Char(36)
  sectionId    String        @db.Char(36)
  studentId    String        @db.Char(36)
  registeredAt DateTime      @default(now()) @db.DateTime(3)
  withdrawnAt  DateTime?     @db.DateTime(3)
  section      CourseSection @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student      User          @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sectionId, studentId])
  @@index([studentId, withdrawnAt])
}

model RoleAssignment {
  id           String      @id @default(uuid()) @db.Char(36)
  userId       String      @db.Char(36)
  role         Role
  scopeType    ScopeType
  // Khóa không NULL: GLOBAL, FACULTY:<uuid> hoặc DEPARTMENT:<uuid>.
  scopeKey     String      @db.VarChar(64)
  facultyId    String?     @db.Char(36)
  departmentId String?     @db.Char(36)
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  faculty      Faculty?    @relation(fields: [facultyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, role, scopeKey])
  @@index([facultyId])
  @@index([departmentId])
}

// Bản thiết kế đầy đủ Tuần 2; không dùng file này để migrate database phát triển.
// Khối nền được ghép từ schema.prisma khi khởi tạo; test DMMF đối chiếu hai bản.

enum AuthTokenKind {
  ACTIVATION
  PASSWORD_RESET
}

enum TemplateStatus {
  NHAP
  DA_KHOA
}

enum QuestionType {
  LIKERT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
  BOOLEAN
}

enum CampaignScope {
  GLOBAL
  FACULTY
  DEPARTMENT
  SECTIONS
}

enum CampaignStatus {
  NHAP
  CHO_XAC_NHAN_DL
  CHO_DUYET
  DA_DUYET
  DANG_MO
  DA_DONG
  DA_TONG_HOP
  DA_CONG_BO
  LUU_TRU
  HUY
}

enum TaskStatus {
  PENDING
  DONE
}

enum ModerationStatus {
  CHO_KIEM_DUYET
  HIEN_THI
  DA_AN
}

enum ImprovementStatus {
  CAN_GIAI_TRINH
  DA_GUI
  CAN_BO_SUNG
  DA_XAC_NHAN
}

enum FeedbackCategory {
  GIANG_DAY
  NOI_DUNG_DE_CUONG
  TAI_LIEU
  KIEM_TRA_DANH_GIA
  THI_KET_THUC_HOC_PHAN
  TO_CHUC_LOP_HOC
  KHIEU_NAI_NGHIEM_TRONG
  KHAC
}

enum FeedbackSeverity {
  GOP_Y
  DE_XUAT
  KHIEU_NAI
}

enum FeedbackStatus {
  MOI
  DA_TIEP_NHAN
  DANG_XU_LY
  DA_TRA_LOI
  DA_DONG
  TU_CHOI
}

enum FeedbackEvent {
  GUI
  TIEP_NHAN
  BAT_DAU_XU_LY
  TRA_LOI
  DONG
  CHUYEN_TIEP
  TU_CHOI
  MO_LAI
  LEO_THANG
  KIEM_DUYET
}

enum DeliveryStatus {
  PROCESSING
  PENDING
  SENT
  FAILED
}

enum SessionPurpose {
  FULL
  PASSWORD_CHANGE
  MFA_SETUP
  MFA_VERIFY
}

model UserSession {
  id               String         @id @default(uuid()) @db.Char(36)
  userId           String         @db.Char(36)
  refreshTokenHash String         @unique @db.Char(64)
  familyId         String         @db.Char(36)
  purpose          SessionPurpose @default(FULL)
  mfaVerifiedAt    DateTime?      @db.DateTime(3)
  expiresAt        DateTime       @db.DateTime(3)
  createdAt        DateTime       @default(now()) @db.DateTime(3)
  revokedAt        DateTime?      @db.DateTime(3)
  userAgent        String?        @db.VarChar(512)
  rotatedFromId    String?        @unique @db.Char(36)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previous         UserSession?   @relation("Rotation", fields: [rotatedFromId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  next             UserSession?   @relation("Rotation")

  @@index([userId, revokedAt])
  @@index([familyId])
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @db.Char(36)
  kind      AuthTokenKind
  tokenHash String        @unique @db.Char(64)
  expiresAt DateTime      @db.DateTime(3)
  usedAt    DateTime?     @db.DateTime(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, kind])
}

model TotpCredential {
  userId           String             @id @db.Char(36)
  encryptedSecret  String             @db.Text
  keyVersion       String             @db.VarChar(32)
  enabledAt        DateTime?          @db.DateTime(3)
  pendingExpiresAt DateTime?          @db.DateTime(3)
  lastUsedStep     BigInt?
  failedAttempts   Int                @default(0)
  lockedUntil      DateTime?          @db.DateTime(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recoveryCodes    TotpRecoveryCode[]
}

model TotpRecoveryCode {
  id         String         @id @default(uuid()) @db.Char(36)
  userId     String         @db.Char(36)
  codeHash   String         @unique @db.Char(64)
  usedAt     DateTime?      @db.DateTime(3)
  credential TotpCredential @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
}

model RateLimitBucket {
  keyHash     String    @id @db.Char(64)
  attempts    Int       @default(0)
  windowStart DateTime  @db.DateTime(3)
  lockedUntil DateTime? @db.DateTime(3)
}

model SurveyTemplate {
  id          String           @id @default(uuid()) @db.Char(36)
  familyId    String           @db.Char(36)
  version     Int
  name        String           @db.VarChar(200)
  status      TemplateStatus   @default(NHAP)
  isDefault   Boolean          @default(false)
  revision    Int              @default(1)
  updatedAt   DateTime         @default(now()) @updatedAt @db.DateTime(3)
  createdById String           @db.Char(36)
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  lockedAt    DateTime?        @db.DateTime(3)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  groups      CriterionGroup[]
  campaigns   SurveyCampaign[]

  @@unique([familyId, version])
  @@index([createdById])
}

model CriterionGroup {
  isAssessmentGroup Boolean        @default(false)
  id                String         @id @default(uuid()) @db.Char(36)
  templateId        String         @db.Char(36)
  title             String         @db.VarChar(200)
  position          Int
  weight            Decimal        @default(1) @db.Decimal(10, 4)
  template          SurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  questions         Question[]

  @@unique([templateId, position])
}

model Question {
  id       String           @id @default(uuid()) @db.Char(36)
  groupId  String           @db.Char(36)
  label    String           @db.VarChar(1000)
  type     QuestionType
  position Int
  required Boolean          @default(true)
  allowNA  Boolean          @default(false)
  weight   Decimal          @default(1) @db.Decimal(10, 4)
  scaleMin Int?
  scaleMax Int?
  group    CriterionGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  options  QuestionOption[]

  @@unique([groupId, position])
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Char(36)
  questionId String   @db.Char(36)
  label      String   @db.VarChar(500)
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([questionId, position])
}

model SurveyCampaign {
  revision            Int                        @default(1)
  updatedAt           DateTime                   @default(now()) @updatedAt @db.DateTime(3)
  openedAt            DateTime?                  @db.DateTime(3)
  openedSnapshotHash  String?                    @db.Char(64)
  dataDriftDetected   Boolean                    @default(false)
  dataConfirmations   CampaignDataConfirmation[]
  anomalyFlags        SurveyAnomalyFlag[]
  inspectionCases     InspectionCase[]
  examRecommendations ExamReviewRecommendation[]
  id                  String                     @id @default(uuid()) @db.Char(36)
  title               String                     @db.VarChar(200)
  semesterId          String                     @db.Char(36)
  templateId          String                     @db.Char(36)
  scope               CampaignScope
  facultyId           String?                    @db.Char(36)
  departmentId        String?                    @db.Char(36)
  startsAt            DateTime                   @db.DateTime(3)
  endsAt              DateTime                   @db.DateTime(3)
  status              CampaignStatus             @default(NHAP)
  minResponses        Int                        @default(5)
  minRate             Decimal                    @default(0.30) @db.Decimal(5, 4)
  warningScore        Decimal                    @default(3.0) @db.Decimal(5, 2)
  explanationDays     Int                        @default(14)
  mandatory           Boolean                    @default(false)
  createdById         String                     @db.Char(36)
  approvedById        String?                    @db.Char(36)
  approvedAt          DateTime?                  @db.DateTime(3)
  createdAt           DateTime                   @default(now()) @db.DateTime(3)
  semester            Semester                   @relation(fields: [semesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  template            SurveyTemplate             @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  faculty             Faculty?                   @relation(fields: [facultyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department          Department?                @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy           User                       @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy          User?                      @relation("CampaignApprover", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sections            CampaignSection[]
  history             CampaignHistory[]
  reminders           SurveyReminder[]

  @@index([semesterId, status])
  @@index([status, startsAt, endsAt])
  @@index([templateId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([createdById])
  @@index([approvedById])
}

model CampaignSection {
  campaignId   String            @db.Char(36)
  sectionId    String            @db.Char(36)
  campaign     SurveyCampaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  section      CourseSection     @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks        SurveyTask[]
  result       AggregateResult?
  improvements ImprovementPlan[]

  @@id([campaignId, sectionId])
  @@index([sectionId])
}

model CampaignHistory {
  action           String?        @db.VarChar(50)
  requestId        String?        @db.Char(36)
  requestHash      String?        @db.Char(64)
  campaignRevision Int?
  id               String         @id @default(uuid()) @db.Char(36)
  campaignId       String         @db.Char(36)
  actorId          String?        @db.Char(36)
  fromStatus       CampaignStatus
  toStatus         CampaignStatus
  reason           String?        @db.Text
  occurredAt       DateTime       @default(now()) @db.DateTime(3)
  campaign         SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor            User?          @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([campaignId, requestId])
  @@index([campaignId, occurredAt])
  @@index([actorId])
}

model SurveyTask {
  id         String          @id @default(uuid()) @db.Char(36)
  campaignId String          @db.Char(36)
  sectionId  String          @db.Char(36)
  studentId  String          @db.Char(36)
  status     TaskStatus      @default(PENDING)
  doneDate   DateTime?       @db.Date
  cohort     CampaignSection @relation(fields: [campaignId, sectionId], references: [campaignId, sectionId], onDelete: Restrict, onUpdate: Restrict)
  student    User            @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([campaignId, sectionId, studentId])
  @@index([studentId, status])
}

// VÙNG ẨN DANH: chỉ quan hệ Response <-> Answer. Các ID metadata là scalar.
model SurveyResponse {
  id            String         @id @default(uuid()) @db.Char(36)
  campaignId    String         @db.Char(36)
  sectionId     String         @db.Char(36)
  submittedDate DateTime       @db.Date
  answers       SurveyAnswer[]

  @@index([campaignId, sectionId])
}

model SurveyAnswer {
  id               String           @id @default(uuid()) @db.Char(36)
  responseId       String           @db.Char(36)
  questionId       String           @db.Char(36)
  valueNumber      Decimal?         @db.Decimal(10, 4)
  valueText        String?          @db.Text
  valueOptionIds   Json?
  valueBoolean     Boolean?
  isNotApplicable  Boolean          @default(false)
  moderationStatus ModerationStatus @default(CHO_KIEM_DUYET)
  moderationReason String?          @db.VarChar(500)
  response         SurveyResponse   @relation(fields: [responseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId, moderationStatus])
}

model AggregateResult {
  id                String          @id @default(uuid()) @db.Char(36)
  campaignId        String          @db.Char(36)
  sectionId         String          @db.Char(36)
  responseCount     Int
  taskCount         Int
  participationRate Decimal         @db.Decimal(7, 4)
  overallScore      Decimal?        @db.Decimal(5, 2)
  details           Json
  eligibleToPublish Boolean
  aggregatedAt      DateTime        @db.DateTime(3)
  cohort            CampaignSection @relation(fields: [campaignId, sectionId], references: [campaignId, sectionId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([campaignId, sectionId])
}

model ImprovementPlan {
  id            String               @id @default(uuid()) @db.Char(36)
  campaignId    String               @db.Char(36)
  sectionId     String               @db.Char(36)
  teacherId     String               @db.Char(36)
  status        ImprovementStatus    @default(CAN_GIAI_TRINH)
  explanation   String?              @db.Text
  actionPlan    String?              @db.Text
  dueAt         DateTime             @db.DateTime(3)
  submittedAt   DateTime?            @db.DateTime(3)
  confirmedById String?              @db.Char(36)
  confirmedAt   DateTime?            @db.DateTime(3)
  reviewComment String?              @db.Text
  cohort        CampaignSection      @relation(fields: [campaignId, sectionId], references: [campaignId, sectionId], onDelete: Restrict, onUpdate: Restrict)
  teacher       User                 @relation("ImprovementTeacher", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmedBy   User?                @relation("ImprovementReviewer", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  history       ImprovementHistory[]

  @@unique([campaignId, sectionId, teacherId])
  @@index([teacherId, status])
  @@index([confirmedById])
}

model ImprovementHistory {
  id         String            @id @default(uuid()) @db.Char(36)
  planId     String            @db.Char(36)
  actorId    String            @db.Char(36)
  fromStatus ImprovementStatus
  toStatus   ImprovementStatus
  note       String?           @db.Text
  occurredAt DateTime          @default(now()) @db.DateTime(3)
  plan       ImprovementPlan   @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor      User              @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([planId, occurredAt])
  @@index([actorId])
}

// Phản hồi giữ người gửi để đối thoại; service phải ẩn danh tính khi chiếu dữ liệu.
model Feedback {
  identityLevel    FeedbackIdentityLevel @default(AN_DANH_HOAN_TOAN)
  inspectionCase   InspectionCase?
  id               String                @id @default(uuid()) @db.Char(36)
  sectionId        String                @db.Char(36)
  authorId         String                @db.Char(36)
  assigneeId       String?               @db.Char(36)
  category         FeedbackCategory
  severity         FeedbackSeverity
  title            String                @db.VarChar(200)
  body             String                @db.Text
  isAnonymous      Boolean               @default(true)
  status           FeedbackStatus        @default(MOI)
  isOverdue        Boolean               @default(false)
  isHidden         Boolean               @default(false)
  isLocked         Boolean               @default(false)
  moderationReason String?               @db.VarChar(500)
  escalationLevel  Int                   @default(0)
  reopenCount      Int                   @default(0)
  createdAt        DateTime              @default(now()) @db.DateTime(3)
  acceptDueAt      DateTime              @db.DateTime(3)
  replyDueAt       DateTime              @db.DateTime(3)
  answeredAt       DateTime?             @db.DateTime(3)
  closedAt         DateTime?             @db.DateTime(3)
  section          CourseSection         @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author           User                  @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee         User?                 @relation("FeedbackAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipients       FeedbackRecipient[]
  messages         FeedbackMessage[]
  attachments      Attachment[]
  history          FeedbackHistory[]
  escalations      SlaEscalation[]
  rating           FeedbackRating?

  @@index([authorId, createdAt])
  @@index([assigneeId, status, replyDueAt])
  @@index([sectionId])
  @@index([status, isOverdue])
}

model FeedbackRecipient {
  feedbackId String   @db.Char(36)
  userId     String   @db.Char(36)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([feedbackId, userId])
  @@index([userId])
}

model FeedbackMessage {
  id               String   @id @default(uuid()) @db.Char(36)
  feedbackId       String   @db.Char(36)
  authorId         String   @db.Char(36)
  body             String   @db.Text
  isHidden         Boolean  @default(false)
  moderationReason String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  feedback         Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author           User     @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([feedbackId, createdAt])
  @@index([authorId])
}

model FeedbackHistory {
  id             String         @id @default(uuid()) @db.Char(36)
  feedbackId     String         @db.Char(36)
  actorId        String?        @db.Char(36)
  event          FeedbackEvent
  fromStatus     FeedbackStatus
  toStatus       FeedbackStatus
  fromAssigneeId String?        @db.Char(36)
  toAssigneeId   String?        @db.Char(36)
  reason         String?        @db.Text
  occurredAt     DateTime       @default(now()) @db.DateTime(3)
  feedback       Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([feedbackId, occurredAt])
  @@index([actorId])
}

model FeedbackRating {
  feedbackId String   @id @db.Char(36)
  score      Int
  comment    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model Attachment {
  id           String   @id @default(uuid()) @db.Char(36)
  feedbackId   String   @db.Char(36)
  storageKey   String   @unique @db.VarChar(160)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  byteSize     Int
  sha256       String   @db.Char(64)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([feedbackId])
}

model SlaEscalation {
  id          String   @id @default(uuid()) @db.Char(36)
  feedbackId  String   @db.Char(36)
  level       Int
  processedAt DateTime @default(now()) @db.DateTime(3)
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([feedbackId, level])
}

model SurveyReminder {
  id           String         @id @default(uuid()) @db.Char(36)
  campaignId   String         @db.Char(36)
  studentId    String         @db.Char(36)
  reminderDate DateTime       @db.Date
  campaign     SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student      User           @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([campaignId, studentId, reminderDate])
  @@index([studentId])
}

model Notification {
  id         String       @id @default(uuid()) @db.Char(36)
  userId     String       @db.Char(36)
  title      String       @db.VarChar(200)
  body       String       @db.Text
  targetType String       @db.VarChar(64)
  targetId   String?      @db.Char(36)
  createdAt  DateTime     @default(now()) @db.DateTime(3)
  readAt     DateTime?    @db.DateTime(3)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  email      EmailOutbox?

  @@index([userId, readAt, createdAt])
}

model EmailOutbox {
  leaseToken     String?        @db.Char(36)
  leaseUntil     DateTime?      @db.DateTime(3)
  id             String         @id @default(uuid()) @db.Char(36)
  notificationId String         @unique @db.Char(36)
  idempotencyKey String         @unique @db.VarChar(160)
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @db.DateTime(3)
  sentAt         DateTime?      @db.DateTime(3)
  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt])
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @db.Char(36)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedById])
}

// Không log nội dung phiếu; không ghép actor sinh viên với ID phiếu/answer khi nộp.
model AuditLog {
  id              String   @id @default(uuid()) @db.Char(36)
  actorId         String?  @db.Char(36)
  action          String   @db.VarChar(100)
  objectType      String   @db.VarChar(64)
  objectId        String?  @db.Char(36)
  redactedSummary Json?
  occurredAt      DateTime @default(now()) @db.DateTime(3)
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, occurredAt])
  @@index([objectType, objectId])
}

// Bổ sung 01: chỉ là blueprint cho các tuần 7–12, chưa migrate hoặc có workflow.
enum FeedbackIdentityLevel {
  AN_DANH_HOAN_TOAN
  CHO_THANH_TRA_BIET
}

enum DataConfirmationStatus {
  DA_XAC_NHAN
  TRA_VE
}

enum InspectionSource {
  PHAN_HOI_NGHIEM_TRONG
  CHUYEN_PHAN_HOI
  BAT_THUONG_KHAO_SAT
}

enum InspectionViolation {
  VI_PHAM_QUY_CHE_GIANG_DAY
  GAY_AP_LUC_KHI_KHAO_SAT
  HANH_VI_KHONG_PHU_HOP
  VI_PHAM_QUY_CHE_THI_KIEM_TRA
  KHAC_NGHIEM_TRONG
}

enum InspectionStatus {
  TIEP_NHAN
  XAC_MINH
  KET_LUAN
  THONG_BAO
  DONG
  TU_CHOI
  CHUYEN_LAI
}

enum InspectionConclusion {
  CO_CAN_CU
  KHONG_CAN_CU
  KHONG_DU_THONG_TIN
  CHUYEN_DON_VI_KHAC
}

enum AnomalyReviewStatus {
  CHO_XEM_XET
  BINH_THUONG
  CAN_LUU_Y
  CHUYEN_XAC_MINH
}

enum ExamRecommendationStatus {
  DA_GUI
  DA_PHAN_HOI
}

enum ExamRecommendationOutcome {
  DA_TIEP_THU
  KHONG_TIEP_THU
}

enum ImportBatchStatus {
  NHAP
  DA_AP_DUNG
  DA_HOAN_TAC
}

model CampaignDataConfirmation {
  campaignRevision Int
  id               String                 @id @default(uuid()) @db.Char(36)
  campaignId       String                 @db.Char(36)
  status           DataConfirmationStatus
  confirmedById    String                 @db.Char(36)
  occurredAt       DateTime               @default(now()) @db.DateTime(3)
  snapshotHash     String                 @db.Char(64)
  sectionCount     Int
  pairCount        Int
  warnings         Json
  reason           String?                @db.VarChar(1000)
  campaign         SurveyCampaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmedBy      User                   @relation(fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([campaignId, campaignRevision])
  @@index([campaignId, occurredAt])
  @@index([confirmedById])
}

model InspectionCase {
  id             String                @id @default(uuid()) @db.Char(36)
  feedbackId     String?               @unique @db.Char(36)
  anomalyFlagId  String?               @unique @db.Char(36)
  campaignId     String?               @db.Char(36)
  sectionId      String                @db.Char(36)
  source         InspectionSource
  violation      InspectionViolation?
  status         InspectionStatus      @default(TIEP_NHAN)
  conclusion     InspectionConclusion?
  reason         String?               @db.Text
  studentSummary String?               @db.Text
  assigneeId     String?               @db.Char(36)
  createdById    String?               @db.Char(36)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  acceptDueAt    DateTime              @db.DateTime(3)
  completeDueAt  DateTime              @db.DateTime(3)
  acceptedAt     DateTime?             @db.DateTime(3)
  closedAt       DateTime?             @db.DateTime(3)
  feedback       Feedback?             @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  anomalyFlag    SurveyAnomalyFlag?    @relation(fields: [anomalyFlagId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign       SurveyCampaign?       @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  section        CourseSection         @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee       User?                 @relation("InspectionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User?                 @relation("InspectionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notes          InspectionCaseNote[]
  events         InspectionCaseEvent[]

  @@index([assigneeId, status, completeDueAt])
  @@index([sectionId])
}

model InspectionCaseNote {
  id             String         @id @default(uuid()) @db.Char(36)
  caseId         String         @db.Char(36)
  authorId       String         @db.Char(36)
  body           String         @db.Text
  internalFiles  Json?
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  inspectionCase InspectionCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([caseId, createdAt])
}

// Lịch sử chỉ thêm. Enforcement service/test triển khai ở Tuần11.
model InspectionCaseEvent {
  id             String            @id @default(uuid()) @db.Char(36)
  caseId         String            @db.Char(36)
  actorId        String            @db.Char(36)
  fromStatus     InspectionStatus?
  toStatus       InspectionStatus
  reason         String?           @db.Text
  occurredAt     DateTime          @default(now()) @db.DateTime(3)
  inspectionCase InspectionCase    @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User              @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([caseId, occurredAt])
}

model SurveyAnomalyFlag {
  id             String              @id @default(uuid()) @db.Char(36)
  campaignId     String              @db.Char(36)
  sectionId      String              @db.Char(36)
  ruleCode       String              @db.VarChar(32)
  metrics        Json
  status         AnomalyReviewStatus @default(CHO_XEM_XET)
  reviewedById   String?             @db.Char(36)
  note           String?             @db.Text
  createdAt      DateTime            @default(now()) @db.DateTime(3)
  reviewedAt     DateTime?           @db.DateTime(3)
  campaign       SurveyCampaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  section        CourseSection       @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy     User?               @relation(fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspectionCase InspectionCase?

  @@unique([campaignId, sectionId, ruleCode])
}

model ExamReviewRecommendation {
  id             String                     @id @default(uuid()) @db.Char(36)
  campaignId     String                     @db.Char(36)
  courseId       String                     @db.Char(36)
  senderId       String                     @db.Char(36)
  recipientId    String                     @db.Char(36)
  body           String                     @db.Text
  status         ExamRecommendationStatus   @default(DA_GUI)
  outcome        ExamRecommendationOutcome?
  responseReason String?                    @db.Text
  createdAt      DateTime                   @default(now()) @db.DateTime(3)
  dueAt          DateTime                   @db.DateTime(3)
  respondedAt    DateTime?                  @db.DateTime(3)
  campaign       SurveyCampaign             @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  course         Course                     @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sender         User                       @relation("ExamSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient      User                       @relation("ExamRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([recipientId, status, dueAt])
}

model ImportBatch {
  id                String            @id @default(uuid()) @db.Char(36)
  kind              String            @db.VarChar(32)
  fileName          String            @db.VarChar(255)
  fileHash          String            @db.Char(64)
  validRows         Int
  errorRows         Int
  importedById      String            @db.Char(36)
  status            ImportBatchStatus @default(NHAP)
  appliedReferences Json?
  createdAt         DateTime          @default(now()) @db.DateTime(3)
  appliedAt         DateTime?         @db.DateTime(3)
  revertedAt        DateTime?         @db.DateTime(3)
  importedBy        User              @relation(fields: [importedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([importedById, createdAt])
}
